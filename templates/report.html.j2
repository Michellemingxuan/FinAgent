<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FinAgent — {{ ctx.generated_at }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f4f6f8;
      --surface: #ffffff;
      --border: #dfe3e8;
      --border-light: #f0f1f4;
      --text: #1a2330;
      --text-secondary: #566072;
      --text-muted: #9ca3af;
      --accent: #0b5cab;
      --accent-light: #eef4fb;
      --accent-border: #bcd6ef;
      --green: #16864d;
      --green-bg: #f0fdf4;
      --green-border: #bbf7d0;
      --red: #cc1f1f;
      --red-bg: #fef2f2;
      --red-border: #fecaca;
      --yellow: #d97706;
      --yellow-bg: #fffbeb;
      --yellow-border: #fde68a;
      --orange: #ea580c;
      --orange-bg: #fff7ed;
      --orange-border: #fed7aa;
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.07), 0 1px 2px -1px rgb(0 0 0 / 0.07);
      --radius: 8px;
    }

    /* ── Dark mode ── */
    [data-theme="dark"] {
      --bg: #0f1117;
      --surface: #1a1d27;
      --border: #2d3041;
      --border-light: #252836;
      --text: #e4e6ed;
      --text-secondary: #9ca3af;
      --text-muted: #6b7280;
      --accent: #5fa3e0;
      --accent-light: #1e293b;
      --accent-border: #0b5cab;
      --green: #4ade80;
      --green-bg: #052e16;
      --green-border: #166534;
      --red: #f87171;
      --red-bg: #450a0a;
      --red-border: #991b1b;
      --yellow: #fbbf24;
      --yellow-bg: #422006;
      --yellow-border: #92400e;
      --orange: #fb923c;
      --orange-bg: #431407;
      --orange-border: #9a3412;
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.2);
      --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.3);
    }
    [data-theme="dark"] .ai-block { background: var(--accent-light); }
    [data-theme="dark"] .ai-text { color: var(--text-secondary); }
    [data-theme="dark"] .kpi-grid { background: var(--border); }
    [data-theme="dark"] .source-wsj { background: #422006; color: #fbbf24; }
    [data-theme="dark"] .source-yahoofinance { background: #2e1065; color: #c4b5fd; }
    [data-theme="dark"] .source-googlenews { background: #0c4a6e; color: #7dd3fc; }
    [data-theme="dark"] .source-cnbc { background: #422006; color: #fde68a; }
    [data-theme="dark"] .source-marketwatch { background: #052e16; color: #86efac; }
    [data-theme="dark"] .source-reuters { background: #4c0519; color: #fda4af; }
    [data-theme="dark"] canvas.sparkline { filter: brightness(1.2); }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--text); font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 13px; line-height: 1.5; -webkit-font-smoothing: antialiased; transition: background 0.3s, color 0.3s; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ── Top utility strip (Barchart-style) ── */
    .topbar { background: var(--surface); border-bottom: 1px solid var(--border-light); padding: 4px 32px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .topbar-controls { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

    /* ── Header / masthead ── */
    .header { background: var(--surface); border-bottom: 1px solid var(--border); padding: 0 32px; }
    .header-top { display: flex; align-items: center; justify-content: space-between; padding: 13px 0 11px; gap: 16px; flex-wrap: wrap; }
    .header-title { font-family: 'Roboto', sans-serif; font-size: 22px; font-weight: 900; letter-spacing: -0.6px; color: var(--accent); }
    .header-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .header-meta { font-size: 11px; color: var(--text-muted); }
    .btn { display: inline-flex; align-items: center; gap: 5px; padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; border: 1px solid var(--border); background: var(--surface); color: var(--text); text-decoration: none; transition: background 0.15s; }
    .btn:hover { background: var(--bg); text-decoration: none; }
    .btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    .btn-primary:hover { background: #08487f; }
    .btn-danger { background: var(--red); color: #fff; border-color: var(--red); }
    .btn-danger:hover { background: #b91c1c; }

    /* ── Tab bar ── */
    .tab-bar { display: flex; gap: 0; overflow-x: auto; padding-bottom: 0; }
    .tab { display: flex; align-items: center; gap: 5px; padding: 10px 14px 10px 16px; font-size: 12px; font-weight: 600; color: var(--text-secondary); border-bottom: 2px solid transparent; cursor: grab; white-space: nowrap; transition: color 0.15s, border-color 0.15s, background 0.15s; user-select: none; position: relative; }
    .tab:hover { color: var(--text); background: var(--bg); }
    .tab.active { color: var(--accent); border-bottom-color: var(--accent); }
    .tab.dragging { opacity: 0.4; cursor: grabbing; }
    .tab.drag-over { border-left: 2px solid var(--accent); background: var(--accent-light); }
    .tab-close { display: flex; align-items: center; justify-content: center; width: 14px; height: 14px; border-radius: 3px; font-size: 11px; line-height: 1; color: var(--text-muted); transition: background 0.1s, color 0.1s; flex-shrink: 0; }
    .tab-close:hover { background: var(--red-bg); color: var(--red); }
    .tab-manage { display: none; align-items: center; justify-content: center; width: 14px; height: 14px; border-radius: 3px; font-size: 13px; line-height: 1; color: var(--text-muted); opacity: 0; transition: background 0.1s, color 0.1s, opacity 0.1s; flex-shrink: 0; }
    body.admin-mode .tab-manage { display: flex; }
    body.admin-mode .tab:hover .tab-manage { opacity: 1; }
    .tab-manage:hover { background: var(--red-bg); color: var(--red); }

    /* ── Owner-only controls (hidden until admin mode) ── */
    .admin-only { display: none !important; }
    body.admin-mode .admin-only { display: inline-flex !important; }
    #adminToggle.is-admin { color: var(--accent); }
    .tab-restore { padding: 6px 10px; font-size: 11px; color: var(--text-muted); cursor: pointer; white-space: nowrap; border-bottom: 2px solid transparent; display: none; align-items: center; gap: 3px; }
    .tab-restore.has-hidden { display: flex; }
    .tab-restore:hover { color: var(--accent); }

    /* ── Page layout ── */
    .page { max-width: 1100px; margin: 0 auto; padding: 24px 32px; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }

    /* ── Section shells ── */
    .section { margin-bottom: 24px; }
    .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
    .section-title { font-size: 21px; font-weight: 700; letter-spacing: -0.4px; color: var(--text); }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden; }

    /* ── Tab layout with sticky TOC ── */
    .tab-layout { display: flex; gap: 24px; align-items: flex-start; }
    .tab-main { flex: 1; min-width: 0; }
    .tab-toc { width: 168px; flex-shrink: 0; position: sticky; top: 80px; max-height: calc(100vh - 100px); overflow-y: auto; }
    .toc-list { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--border); }
    .toc-list li { margin: 0; }
    .toc-list a { display: block; padding: 5px 10px; font-size: 11.5px; color: var(--text-muted); text-decoration: none; line-height: 1.4; transition: color 0.15s, border-left-color 0.15s; border-left: 2px solid transparent; margin-left: -2px; }
    .toc-list a:hover { color: var(--text); }
    .toc-list a.toc-active { color: var(--accent); font-weight: 600; border-left-color: var(--accent); }
    .toc-label { font-size: 10px; font-weight: 700; letter-spacing: 0.7px; text-transform: uppercase; color: var(--text-muted); padding: 0 10px 8px; }
    @media (max-width: 900px) { .tab-toc { display: none; } .tab-layout { display: block; } }

    /* ── Analyst ratings table ── */
    .ratings-table { width: 100%; border-collapse: collapse; }
    .ratings-table thead th { padding: 9px 14px; text-align: left; font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; background: var(--bg); border-bottom: 1px solid var(--border); white-space: nowrap; }
    .ratings-table thead th:not(:first-child) { text-align: right; }
    .ratings-table tbody td { padding: 10px 14px; border-bottom: 1px solid var(--border-light); vertical-align: middle; }
    .ratings-table tbody td:not(:first-child) { text-align: right; }
    .ratings-table tbody tr:last-child td { border-bottom: none; }
    .ratings-table tbody tr:hover { background: var(--bg); }
    .firm-name { font-weight: 600; font-size: 13px; }
    .analyst-name { font-size: 12px; color: var(--text-secondary); margin-top: 1px; }

    /* Rating pill */
    .pill { display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 20px; font-size: 11px; font-weight: 700; letter-spacing: 0.3px; }
    .pill-buy { background: var(--green-bg); color: var(--green); border: 1px solid var(--green-border); }
    .pill-sell { background: var(--red-bg); color: var(--red); border: 1px solid var(--red-border); }
    .pill-hold { background: var(--yellow-bg); color: var(--yellow); border: 1px solid var(--yellow-border); }
    .pill-neutral { background: var(--bg); color: var(--text-secondary); border: 1px solid var(--border); }

    /* Price target upside */
    .upside-positive { color: var(--green); font-weight: 600; }
    .upside-negative { color: var(--red); font-weight: 600; }

    /* Performance stars */
    .perf-stars { color: var(--yellow); font-size: 11px; }

    /* ── AI block ── */
    .ai-block { padding: 12px 16px; background: var(--accent-light); border-top: 1px solid var(--accent-border); }
    .ai-label { font-size: 10px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; color: var(--accent); margin-bottom: 5px; }
    .ai-text { font-size: 13px; color: #374151; line-height: 1.65; }

    /* ── Ticker hero ── */
    .ticker-hero { display: flex; align-items: center; gap: 16px; padding: 16px 20px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
    .ticker-symbol { font-size: 22px; font-weight: 900; letter-spacing: -0.6px; }
    .ticker-name { font-size: 13px; color: var(--text-secondary); }
    .ticker-price { font-size: 20px; font-weight: 700; margin-left: auto; }
    .ticker-price-sub { font-size: 11px; color: var(--text-muted); text-align: right; }

    /* ── News ── */
    .news-list { divide-y: var(--border-light); }
    .news-item { padding: 11px 16px; border-bottom: 1px solid var(--border-light); display: flex; gap: 10px; align-items: flex-start; }
    .news-item:last-child { border-bottom: none; }
    .news-item-body { flex: 1; min-width: 0; }
    .news-title { font-size: 13px; font-weight: 600; line-height: 1.4; }
    .news-title a { color: var(--text); }
    .news-title a:hover { color: var(--accent); text-decoration: none; }
    .news-summary { font-size: 12px; color: var(--text-secondary); margin-top: 3px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .news-meta-row { display: flex; align-items: center; gap: 6px; margin-top: 5px; flex-wrap: wrap; }
    .full-text-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); display: inline-block; flex-shrink: 0; }
    .source-tag { font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 3px; letter-spacing: 0.3px; background: var(--border-light); color: var(--text-secondary); }
    .source-wsj { background: #fef3c7; color: #92400e; }
    .source-yahoofinance { background: #ede9fe; color: #5b21b6; }
    .source-googlenews { background: #e0f2fe; color: #075985; }
    .source-cnbc { background: #fef9c3; color: #713f12; }
    .source-marketwatch { background: #f0fdf4; color: #166534; }
    .source-reuters { background: #fff1f2; color: #9f1239; }
    .news-date { font-size: 11px; color: var(--text-muted); }
    .news-summary { font-size: 12px; color: var(--text-secondary); margin-top: 5px; line-height: 1.5; }
    .ticker-tags { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 6px; }
    .ticker-tag { font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 3px; background: var(--bg); border: 1px solid var(--border); color: var(--text-secondary); }
    .full-text-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); display: inline-block; margin-left: 2px; }

    /* ── Flagged tickers ── */
    .flagged-row { padding: 10px 16px; border-top: 1px solid var(--border); background: var(--yellow-bg); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .flagged-label { font-size: 11px; font-weight: 600; color: var(--yellow); }
    .flag-chip { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 4px; background: var(--surface); border: 1px solid var(--yellow-border); color: var(--yellow); }

    /* ── Financials ── */
    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 1px; background: var(--border); border-bottom: 1px solid var(--border); }
    .kpi-cell { background: var(--surface); padding: 12px 14px; }
    .kpi-label { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); }
    .kpi-value { font-size: 15px; font-weight: 700; margin-top: 3px; letter-spacing: -0.3px; }
    .fin-table { width: 100%; border-collapse: collapse; }
    .fin-table thead th { padding: 9px 14px; text-align: right; font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; background: var(--bg); border-bottom: 1px solid var(--border); }
    .fin-table thead th:first-child { text-align: left; }
    .fin-table tbody td { padding: 9px 14px; text-align: right; border-bottom: 1px solid var(--border-light); }
    .fin-table tbody td:first-child { text-align: left; color: var(--text-secondary); font-weight: 500; }
    .fin-table tbody tr:last-child td { border-bottom: none; }
    .fin-table tbody tr:hover { background: var(--bg); }

    /* ── Geopolitical ── */
    .geo-theme { border-bottom: 1px solid var(--border-light); padding: 14px 16px; }
    .geo-theme:last-child { border-bottom: none; }
    .geo-header { display: flex; align-items: flex-start; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
    .geo-name { font-size: 13px; font-weight: 700; flex: 1; }
    .risk-pill { }
    .risk-low { background: var(--green-bg); color: var(--green); border: 1px solid var(--green-border); }
    .risk-medium { background: var(--yellow-bg); color: var(--yellow); border: 1px solid var(--yellow-border); }
    .risk-medium-high { background: var(--orange-bg); color: var(--orange); border: 1px solid var(--orange-border); }
    .risk-high { background: var(--red-bg); color: var(--red); border: 1px solid var(--red-border); }
    .geo-tickers { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 8px; }
    .geo-analysis { font-size: 13px; color: var(--text-secondary); line-height: 1.6; }
    .geo-headlines { margin-top: 8px; }
    .geo-headline { font-size: 11px; color: var(--text-muted); padding: 2px 0; display: flex; gap: 6px; }
    .geo-headline::before { content: "›"; color: var(--text-muted); }

    /* ── Subsection headers ── */
    .subsec-title { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); padding: 10px 16px; background: var(--bg); border-bottom: 1px solid var(--border); }

    /* ── Empty/error states ── */
    .empty-state { padding: 24px 16px; text-align: center; color: var(--text-muted); font-size: 13px; }
    .error-banner { background: var(--red-bg); border: 1px solid var(--red-border); border-radius: var(--radius); padding: 10px 14px; margin-bottom: 20px; font-size: 12px; color: var(--red); }

    /* ── Macro tab ── */
    .macro-summary { padding: 14px 16px; border-bottom: 1px solid var(--border); }

    /* ── Scrollbar ── */
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

    /* ── Sparkline ── */
    .spark-wrap { display: flex; align-items: center; }
    canvas.sparkline { display: block; }

    /* ── Insider transaction pills ── */
    .pill-insider-buy { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
    .pill-insider-sell { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }

    /* ── Earnings countdown ── */
    .earnings-soon { color: #d97706; font-weight: 600; }
    .earnings-far { color: #6b7280; }

    /* ── Short interest ── */
    .short-high { color: #dc2626; }
    .short-mid { color: #d97706; }
    .short-low { color: #16a34a; }

    /* ── Theme chips ── */
    .theme-chip { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; cursor: default; }

    /* ── Archive select ── */
    .archive-select { padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); color: var(--text); font-size: 12px; cursor: pointer; }

    /* ── Supply Chain diagram ── */
    .sc-diagram-wrap { padding: 16px; overflow-x: auto; }
    .sc-svg { width: 100%; min-width: 560px; }
    .sc-summary { font-size: 12px; color: var(--text-secondary); padding: 0 16px 14px; line-height: 1.55; font-style: italic; }
    .sc-empty { padding: 16px; color: var(--text-muted); font-size: 13px; text-align: center; }

    /* ── Peer table ── */
    .peer-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .peer-table thead th { padding: 8px 12px; text-align: right; font-size: 10px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; background: var(--bg); border-bottom: 1px solid var(--border); white-space: nowrap; }
    .peer-table thead th:first-child { text-align: left; }
    .peer-table tbody td { padding: 9px 12px; text-align: right; border-bottom: 1px solid var(--border-light); }
    .peer-table tbody td:first-child { text-align: left; font-weight: 600; }
    .peer-table tbody tr:last-child td { border-bottom: none; }
    .peer-table tbody tr:hover { background: var(--bg); }

    /* ── Insider table ── */
    .insider-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .insider-table thead th { padding: 8px 12px; text-align: left; font-size: 10px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; background: var(--bg); border-bottom: 1px solid var(--border); }
    .insider-table thead th:not(:first-child):not(:nth-child(2)) { text-align: right; }
    .insider-table tbody td { padding: 9px 12px; border-bottom: 1px solid var(--border-light); }
    .insider-table tbody td:not(:first-child):not(:nth-child(2)) { text-align: right; }
    .insider-table tbody tr:last-child td { border-bottom: none; }
    .insider-table tbody tr:hover { background: var(--bg); }
    .insider-summary { padding: 8px 14px; font-size: 11px; color: var(--text-muted); border-top: 1px solid var(--border); background: var(--bg); }

    /* ── Product Analysis ── */
    .product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 14px 16px; }
    @media (max-width: 700px) { .product-grid { grid-template-columns: 1fr; } }
    .product-metric-card { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px 14px; }
    .product-metric-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 6px; }
    .product-metric-value { font-size: 18px; font-weight: 700; color: var(--text); }
    .product-metric-sub { font-size: 11px; color: var(--text-secondary); margin-top: 2px; }
    /* Segment breakdown */
    .seg-list { padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; border-top: 1px solid var(--border); }
    .seg-row { display: flex; align-items: center; gap: 10px; }
    .seg-name { font-size: 12px; font-weight: 600; color: var(--text); width: 140px; flex-shrink: 0; }
    .seg-bar-track { flex: 1; height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; }
    .seg-bar-fill { height: 100%; border-radius: 4px; }
    .seg-pct { font-size: 12px; font-weight: 700; color: var(--text); width: 36px; text-align: right; flex-shrink: 0; }
    .seg-trend { font-size: 10px; font-weight: 700; padding: 1px 5px; border-radius: 3px; flex-shrink: 0; }
    .seg-trend-growing { background: var(--green-bg); color: var(--green); }
    .seg-trend-stable { background: var(--bg); color: var(--text-muted); border: 1px solid var(--border); }
    .seg-trend-declining { background: var(--red-bg); color: var(--red); }
    .seg-desc { font-size: 11px; color: var(--text-secondary); margin-left: 150px; margin-top: -4px; }
    .value-driver-note { font-size: 12px; color: var(--text-secondary); padding: 8px 16px 12px; border-top: 1px solid var(--border-light); font-style: italic; }
    /* Quarterly revenue chart */
    .qrev-chart { padding: 14px 16px; }
    .qrev-bars { display: flex; align-items: flex-end; gap: 6px; height: 80px; }
    .qrev-bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px; }
    .qrev-bar { width: 100%; border-radius: 3px 3px 0 0; background: var(--accent); opacity: 0.8; transition: opacity 0.15s; min-height: 4px; }
    .qrev-bar:hover { opacity: 1; }
    .qrev-label { font-size: 9px; color: var(--text-muted); text-align: center; white-space: nowrap; }
    .qrev-yoy { font-size: 9px; font-weight: 700; text-align: center; }
    .qrev-yoy.pos { color: var(--green); }
    .qrev-yoy.neg { color: var(--red); }
    /* Earnings beat/miss table */
    .beat-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .beat-table thead th { padding: 8px 14px; text-align: center; font-size: 10px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; background: var(--bg); border-bottom: 1px solid var(--border); }
    .beat-table thead th:first-child { text-align: left; }
    .beat-table tbody td { padding: 9px 14px; border-bottom: 1px solid var(--border-light); text-align: center; }
    .beat-table tbody td:first-child { text-align: left; font-weight: 600; }
    .beat-table tbody tr:last-child td { border-bottom: none; }
    .beat-table tbody tr:hover { background: var(--bg); }
    .beat-pill { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 700; }
    .beat-pos { background: var(--green-bg); color: var(--green); border: 1px solid var(--green-border); }
    .beat-neg { background: var(--red-bg); color: var(--red); border: 1px solid var(--red-border); }
    .beat-neutral { background: var(--bg); color: var(--text-muted); border: 1px solid var(--border); }
    /* Revision badge */
    .revision-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 700; }
    .revision-up { background: var(--green-bg); color: var(--green); border: 1px solid var(--green-border); }
    .revision-down { background: var(--red-bg); color: var(--red); border: 1px solid var(--red-border); }
    .revision-neutral { background: var(--bg); color: var(--text-muted); border: 1px solid var(--border); }

    /* ── Toggle buttons (dark mode + language) ── */
    .toggle-btn { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 5px 10px; font-size: 12px; font-weight: 600; cursor: pointer; color: var(--text); transition: background 0.15s, border-color 0.15s; display: inline-flex; align-items: center; gap: 4px; }
    .toggle-btn:hover { background: var(--bg); border-color: var(--accent); }

    /* ── Add-stock modal ── */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 100; align-items: center; justify-content: center; backdrop-filter: blur(3px); }
    .modal-overlay.visible { display: flex; }
    .modal { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 28px; max-width: 420px; width: 90%; box-shadow: 0 8px 32px rgb(0 0 0 / 0.2); }
    .modal h3 { font-size: 16px; font-weight: 700; margin-bottom: 4px; color: var(--text); }
    .modal p { font-size: 12px; color: var(--text-muted); margin-bottom: 16px; }
    .modal input[type="text"], .modal input[type="password"] { width: 100%; padding: 9px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 13px; color: var(--text); background: var(--bg); margin-bottom: 12px; outline: none; font-family: inherit; }
    .modal input[type="text"]:focus, .modal input[type="password"]:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgb(37 99 235 / 0.15); }
    .modal label { display: block; font-size: 11px; font-weight: 600; color: var(--text-secondary); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.4px; }
    .modal-actions { display: flex; gap: 8px; margin-top: 4px; }
    .modal-actions .btn { flex: 1; justify-content: center; }
    .modal-status { margin-top: 12px; padding: 8px 12px; border-radius: 6px; font-size: 12px; display: none; }
    .modal-status.success { display: block; background: var(--green-bg); color: var(--green); border: 1px solid var(--green-border); }
    .modal-status.error { display: block; background: var(--red-bg); color: var(--red); border: 1px solid var(--red-border); }
    .modal-status.running { display: block; background: var(--accent-light); color: var(--accent); border: 1px solid var(--accent-border); }
    /* Token saved row */
    .token-saved-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; background: var(--green-bg); border: 1px solid var(--green-border); border-radius: 6px; margin-bottom: 12px; font-size: 12px; color: var(--green); }
    .token-saved-row a { font-size: 11px; color: var(--text-muted); cursor: pointer; text-decoration: underline; }
    /* Progress tracker */
    .progress-track { margin-top: 14px; display: none; }
    .progress-track.visible { display: block; }
    .progress-steps { display: flex; flex-direction: column; gap: 6px; }
    .progress-step { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--text-muted); }
    .progress-step.done { color: var(--green); }
    .progress-step.active { color: var(--accent); font-weight: 600; }
    .progress-step.failed { color: var(--red); }
    .step-dot { width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; flex-shrink: 0; background: var(--border); color: var(--text-muted); }
    .progress-step.done .step-dot { background: var(--green-bg); color: var(--green); border: 1px solid var(--green-border); }
    .progress-step.active .step-dot { background: var(--accent-light); color: var(--accent); border: 1px solid var(--accent-border); animation: pulse-dot 1.2s ease-in-out infinite; }
    .progress-step.failed .step-dot { background: var(--red-bg); color: var(--red); border: 1px solid var(--red-border); }
    @keyframes pulse-dot { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }

    [data-theme="dark"] .theme-chip { background: #1e3a5f; color: #93c5fd; border-color: #2563eb; }
    .header, .card { transition: background 0.3s, border-color 0.3s; }

    /* ── Markdown within AI blocks ── */
    .ai-text p { margin: 0 0 6px; }
    .ai-text p:last-child { margin-bottom: 0; }
    .ai-text ul, .ai-text ol { margin: 4px 0 6px 18px; padding: 0; }
    .ai-text li { margin-bottom: 3px; }
    .ai-text strong { font-weight: 700; color: var(--text); }
    .ai-text em { font-style: italic; }
    .ai-text code { background: var(--border-light); border-radius: 3px; padding: 1px 4px; font-size: 12px; font-family: 'SF Mono', 'Fira Code', monospace; }
    .ai-text h1, .ai-text h2, .ai-text h3 { font-size: 13px; font-weight: 700; margin: 8px 0 4px; color: var(--text); }
    .ai-text blockquote { border-left: 3px solid var(--accent-border); margin: 6px 0; padding: 2px 10px; color: var(--text-secondary); }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body>

<!-- ═══ HEADER ═══ -->

<!-- Top utility strip -->
<div class="topbar">
  <div class="header-meta" data-i18n="updated">Updated {{ ctx.generated_at }}</div>
  <div class="topbar-controls">
    <button class="toggle-btn" id="langToggle" onclick="toggleLang()" title="Switch language">EN</button>
    <button class="toggle-btn" id="themeToggle" onclick="toggleTheme()" title="Toggle dark mode">🌙</button>
    {% if archive_dates %}
    <select class="archive-select" onchange="if(this.value) window.location.href=this.value">
      <option value="" data-i18n="history">History</option>
      {% for d in archive_dates | sort(reverse=true) %}
      <option value="archive/{{ d }}.html">{{ d }}</option>
      {% endfor %}
    </select>
    {% endif %}
    {% if github_repo %}
    <button class="toggle-btn" id="adminToggle" onclick="toggleAdmin()" title="Owner sign-in">&#128273;</button>
    {% endif %}
  </div>
</div>

<div class="header">
  <div class="header-top">
    <div class="header-title">FinAgent</div>
    {% if github_repo %}
    <div class="header-actions">
      <button class="btn admin-only" id="addStockBtn" onclick="openAddStock()">
        &#x2b;&nbsp; <span data-i18n="add_stock">Add Stock</span>
      </button>
      <button class="btn btn-primary admin-only" id="refreshReportBtn" onclick="openRefreshReport()">
        &#x21bb;&nbsp; <span data-i18n="refresh_report">Refresh Report</span>
      </button>
    </div>
    {% endif %}
  </div>

  <!-- Tab bar -->
  <div class="tab-bar" id="tabBar">
    {% for tr in ctx.ratings %}
    <div class="tab {% if loop.first %}active{% endif %}" data-tab="stock-{{ tr.symbol }}" data-symbol="{{ tr.symbol }}" draggable="true">
      <span>{{ tr.symbol }}</span>
      <span class="tab-close" title="Hide from view (this browser only)" onclick="closeTab(event, '{{ tr.symbol }}')">&#x2715;</span>
      {% if github_repo %}<span class="tab-manage" title="Stop tracking permanently" onclick="openRemoveStock(event, '{{ tr.symbol }}')">&#8942;</span>{% endif %}
    </div>
    {% endfor %}
    <div class="tab" data-tab="macro" data-i18n="macro_geo">Macro &amp; Geo</div>
    <div class="tab-restore" id="tabRestore" onclick="restoreAllTabs()" title="Show hidden tabs">&#x21ba; <span id="tabRestoreLabel">Restore</span></div>
  </div>
</div>

<!-- ═══ ADD STOCK MODAL ═══ -->
{% if github_repo %}
<div class="modal-overlay" id="addStockModal" onclick="if(event.target===this)closeAddStockModal()">
  <div class="modal">
    <h3 id="stockModalTitle" data-i18n="add_stock_title">Add a Stock</h3>
    <p id="stockModalDesc" data-i18n="add_stock_desc">Enter the ticker symbol. A new report will be generated automatically.</p>

    <div id="tickerInputRow">
      <label for="newTicker" data-i18n="ticker_label">Ticker Symbol</label>
      <input type="text" id="newTicker" placeholder="e.g. MSFT" style="text-transform:uppercase;"
             onkeydown="if(event.key==='Enter')submitAddStock()" />
    </div>

    <!-- Token section: shows saved-token badge OR input -->
    <div id="tokenSavedRow" class="token-saved-row" style="display:none;">
      <span>🔑 GitHub token saved</span>
      <a onclick="showPatInput()">Change</a>
    </div>
    <div id="tokenInputSection">
      <label for="addStockPat" data-i18n="pat_label">GitHub Personal Access Token</label>
      <input type="password" id="addStockPat" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx" autocomplete="off" />
      <div style="font-size:11px;color:var(--text-muted);margin-top:-8px;margin-bottom:12px;">
        Needs <code>workflow</code> scope. &nbsp;
        <a href="https://github.com/settings/tokens/new?scopes=workflow&description=FinAgent" target="_blank" rel="noopener">Create one ↗</a>
      </div>
    </div>

    <div class="modal-actions" id="addStockActions">
      <button class="btn" onclick="closeAddStockModal()" data-i18n="cancel">Cancel</button>
      <button class="btn btn-primary" id="addStockSubmit" onclick="submitAddStock()">Add &amp; Generate</button>
    </div>
    <div class="modal-status" id="addStockStatus"></div>

    <!-- Live progress tracker -->
    <div class="progress-track" id="progressTrack">
      <div class="progress-steps">
        <div class="progress-step" id="pstep-trigger"><span class="step-dot">1</span><span>Triggering workflow</span></div>
        <div class="progress-step" id="pstep-queue"><span class="step-dot">2</span><span>Queued on GitHub Actions</span></div>
        <div class="progress-step" id="pstep-run"><span class="step-dot">3</span><span id="pstep-run-label">Running report generation…</span></div>
        <div class="progress-step" id="pstep-done"><span class="step-dot">4</span><span id="pstep-done-label">Complete — reloading page</span></div>
      </div>
    </div>
  </div>
</div>
{% endif %}

<div class="page">

  {% if ctx.errors %}
  <div class="error-banner">
    <strong>Partial data —</strong>
    {% for e in ctx.errors %}{{ e }}{% if not loop.last %} &bull; {% endif %}{% endfor %}
  </div>
  {% endif %}

  <!-- ═══════════════════════════════════════════════ -->
  <!-- PER-TICKER TABS                                -->
  <!-- ═══════════════════════════════════════════════ -->
  {% for tr in ctx.ratings %}
  {% set loop_idx = loop.index0 %}
  {% set tf = ctx.financials[loop_idx] if loop_idx < ctx.financials|length else none %}
  {% set tp_list = ctx.product_analysis | selectattr("symbol", "equalto", tr.symbol) | list %}
  {% set tp = tp_list[0] if tp_list else none %}
  {% set sym_earnings = ctx.earnings_events | selectattr("symbol", "equalto", tr.symbol) | list %}
  {% set sym_insider = ctx.insider_transactions.get(tr.symbol, []) %}
  {% set sym_short = ctx.short_data.get(tr.symbol, none) %}
  {% set sym_themes = ctx.themes | selectattr("tickers", "containing", tr.symbol) | list %}

  <div class="tab-content {% if loop.first %}active{% endif %}" id="tab-stock-{{ tr.symbol }}">

    <!-- Ticker hero bar -->
    <div class="card" style="margin-bottom:20px;">
      <div class="ticker-hero">
        <div>
          <div class="ticker-symbol">{{ tr.symbol }}</div>
          <div class="ticker-name">{{ tr.name }}</div>
        </div>
        {% if tr.current_price %}
        <div style="margin-left:auto; text-align:right;">
          <div class="ticker-price">{{ fmt_price(tr.current_price) }}</div>
          <div class="ticker-price-sub">Current price</div>
        </div>
        {% endif %}
        <div class="spark-wrap">
          <canvas id="spark-{{ tr.symbol }}" class="sparkline" width="160" height="48"></canvas>
        </div>
      </div>
    </div>

    <div class="tab-layout">
      <!-- ── Right-side sticky TOC ── -->
      <nav class="tab-toc" id="toc-{{ tr.symbol }}" aria-label="On this page">
        <div class="toc-label">On this page</div>
        <ul class="toc-list">
          <li><a href="#sec-analyst-{{ tr.symbol }}">Analyst Ratings</a></li>
          {% if sym_earnings %}<li><a href="#sec-earnings-{{ tr.symbol }}">Upcoming Earnings</a></li>{% endif %}
          <li><a href="#sec-news-{{ tr.symbol }}">News</a></li>
          <li><a href="#sec-financials-{{ tr.symbol }}">Financials</a></li>
          {% if tp %}<li><a href="#sec-product-{{ tr.symbol }}">Product &amp; Momentum</a></li>{% endif %}
          {% if sym_insider %}<li><a href="#sec-insider-{{ tr.symbol }}">Insider Transactions</a></li>{% endif %}
          {% set ticker_geo = ctx.geopolitical_themes | selectattr("affected_tickers", "containing", tr.symbol) | list %}
          {% if ticker_geo %}<li><a href="#sec-geo-{{ tr.symbol }}">Geopolitical Exposure</a></li>{% endif %}
          {% if sym_themes %}<li><a href="#sec-themes-{{ tr.symbol }}">Portfolio Themes</a></li>{% endif %}
          <li><a href="#sec-sc-{{ tr.symbol }}">Supply Chain Map</a></li>
        </ul>
      </nav>

      <!-- ── Main content ── -->
      <div class="tab-main">

    <!-- ── SECTION: ANALYST RATINGS ── -->
    <div class="section" id="sec-analyst-{{ tr.symbol }}">
      <div class="section-header">
        <span class="section-title" data-i18n="analyst_ratings">Analyst Ratings</span>
      </div>
      <div class="card">
        {% if tr.ratings %}
        <table class="ratings-table">
          <thead>
            <tr>
              <th>Firm &amp; Analyst</th>
              <th>Action</th>
              <th>Rating</th>
              <th>Price Target</th>
              <th>PT Upside</th>
              <th>Analyst Perf.</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            {% for r in tr.ratings %}
            {% set upside = none %}
            {% if r.price_target and tr.current_price and tr.current_price > 0 %}
              {% set upside = (r.price_target - tr.current_price) / tr.current_price * 100 %}
            {% endif %}
            <tr>
              <td>
                <div class="firm-name">{{ r.firm }}</div>
                {% if r.analyst %}<div class="analyst-name">{{ r.analyst }}</div>{% endif %}
              </td>
              <td style="color:var(--text-secondary)">{{ r.action or "—" }}</td>
              <td>
                {% if r.rating %}
                <span class="pill
                  {%- if 'buy' in r.rating.lower() or 'overweight' in r.rating.lower() or 'outperform' in r.rating.lower() %} pill-buy
                  {%- elif 'sell' in r.rating.lower() or 'underweight' in r.rating.lower() or 'underperform' in r.rating.lower() %} pill-sell
                  {%- elif 'hold' in r.rating.lower() or 'neutral' in r.rating.lower() or 'equal' in r.rating.lower() %} pill-hold
                  {%- else %} pill-neutral{%- endif %}">
                  {{ r.rating }}
                </span>
                {% if r.previous_rating and r.previous_rating != r.rating %}
                <span style="font-size:10px;color:var(--text-muted);margin-left:4px;">← {{ r.previous_rating }}</span>
                {% endif %}
                {% else %}—{% endif %}
              </td>
              <td>
                {% if r.price_target %}
                {{ fmt_price(r.price_target) }}
                {% if r.previous_price_target and r.previous_price_target != r.price_target %}
                <span style="font-size:10px;color:var(--text-muted);margin-left:3px;">← {{ fmt_price(r.previous_price_target) }}</span>
                {% endif %}
                {% else %}—{% endif %}
              </td>
              <td>
                {% if upside is not none %}
                <span class="{{ 'upside-positive' if upside >= 0 else 'upside-negative' }}">
                  {{ "%+.1f"|format(upside) }}%
                </span>
                {% else %}—{% endif %}
              </td>
              <td>
                <span class="perf-stars" title="Analyst performance data requires FMP premium">—</span>
              </td>
              <td style="color:var(--text-muted)">{{ r.date }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
        <div class="empty-state">No recent analyst ratings available{% if tr.error %}: {{ tr.error }}{% endif %}</div>
        {% endif %}
        <div class="ai-block">
          <div class="ai-label">AI Consensus Summary</div>
          <div class="ai-text">{{ tr.ai_rationale }}</div>
        </div>
      </div>
    </div>

    <!-- ── SECTION: UPCOMING EARNINGS ── -->
    {% if sym_earnings %}
    {% set ev = sym_earnings[0] %}
    <div class="section" id="sec-earnings-{{ tr.symbol }}">
      <div class="section-header">
        <span class="section-title" data-i18n="upcoming_earnings">Upcoming Earnings</span>
      </div>
      <div class="card" style="padding:14px 16px;">
        <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:center;">
          <div>
            <div class="kpi-label">Earnings Date</div>
            <div class="kpi-value" style="font-size:14px;">{{ ev.earnings_date }}</div>
          </div>
          {% if ev.days_until is not none %}
          <div>
            <div class="kpi-label">Days Until</div>
            <div class="kpi-value {{ 'earnings-soon' if ev.days_until <= 7 else 'earnings-far' }}" style="font-size:14px;">
              {% if ev.days_until == 0 %}Today
              {% elif ev.days_until < 0 %}Past
              {% else %}in {{ ev.days_until }} day{{ 's' if ev.days_until != 1 else '' }}
              {% endif %}
            </div>
          </div>
          {% endif %}
          {% if ev.eps_estimate is not none %}
          <div>
            <div class="kpi-label">EPS Estimate</div>
            <div class="kpi-value" style="font-size:14px;">${{ "%.2f"|format(ev.eps_estimate) }}</div>
          </div>
          {% endif %}
          {% if ev.revenue_estimate is not none %}
          <div>
            <div class="kpi-label">Revenue Estimate</div>
            <div class="kpi-value" style="font-size:14px;">{{ fmt_b(ev.revenue_estimate) }}</div>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
    {% endif %}

    <!-- ── SECTION: NEWS ── -->
    <div class="section" id="sec-news-{{ tr.symbol }}">
      <div class="section-header">
        <span class="section-title" data-i18n="news">News</span>
      </div>
      <div class="card">
        {% set direct = ctx.news.direct_news | selectattr("relevant_tickers", "containing", tr.symbol) | list %}
        {% set related = ctx.news.market_news | selectattr("relevant_tickers", "containing", tr.symbol) | list %}
        {% set all_items = (direct + related) %}

        {% if all_items %}
          {% if direct %}
          <div class="subsec-title">Direct Coverage</div>
          {% for item in direct %}
          <div class="news-item">
            <div class="news-item-body">
              <div class="news-title">
                <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
                {% if item.full_text_available %}&nbsp;<span class="full-text-dot" title="Full article available"></span>{% endif %}
              </div>
              {% if item.summary %}<div class="news-summary">{{ item.summary[:200] }}</div>{% endif %}
              <div class="news-meta-row">
                <span class="source-tag source-{{ item.source.lower().replace(' ','').replace('.','') }}">{{ item.source }}</span>
                <span class="news-date">{{ item.published }}</span>
              </div>
            </div>
          </div>
          {% endfor %}
          {% endif %}

          {% if related %}
          <div class="subsec-title">Supply Chain &amp; Adjacent</div>
          {% for item in related %}
          <div class="news-item">
            <div class="news-item-body">
              <div class="news-title">
                <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
              </div>
              {% if item.summary %}<div class="news-summary">{{ item.summary[:200] }}</div>{% endif %}
              <div class="news-meta-row">
                <span class="source-tag source-{{ item.source.lower().replace(' ','').replace('.','') }}">{{ item.source }}</span>
                <span class="news-date">{{ item.published }}</span>
                {% for t in item.relevant_tickers %}
                <span class="ticker-tag">{{ t }}</span>
                {% endfor %}
              </div>
            </div>
          </div>
          {% endfor %}
          {% endif %}

        {% else %}
          <div class="empty-state">No recent news found for {{ tr.symbol }}</div>
        {% endif %}
      </div>
    </div>

    <!-- ── SECTION: FINANCIALS ── -->
    {% if tf %}
    <div class="section" id="sec-financials-{{ tr.symbol }}">
      <div class="section-header">
        <span class="section-title" data-i18n="financials">Financial Statements</span>
      </div>
      <div class="card">
        <!-- KPI strip -->
        <div class="kpi-grid">
          <div class="kpi-cell">
            <div class="kpi-label">Market Cap</div>
            <div class="kpi-value">{{ fmt_b(tf.market_cap) }}</div>
          </div>
          <div class="kpi-cell">
            <div class="kpi-label">Trailing P/E</div>
            <div class="kpi-value">{{ "%.1f×"|format(tf.pe_ratio) if tf.pe_ratio else "—" }}</div>
          </div>
          <div class="kpi-cell">
            <div class="kpi-label">Forward P/E</div>
            <div class="kpi-value">{{ "%.1f×"|format(tf.forward_pe) if tf.forward_pe else "—" }}</div>
          </div>
          <div class="kpi-cell">
            <div class="kpi-label">EV / EBITDA</div>
            <div class="kpi-value">{{ "%.1f×"|format(tf.ev_ebitda) if tf.ev_ebitda else "—" }}</div>
          </div>
          <div class="kpi-cell">
            <div class="kpi-label">Debt / Equity</div>
            <div class="kpi-value">{{ "%.2f"|format(tf.debt_to_equity) if tf.debt_to_equity else "—" }}</div>
          </div>
          <div class="kpi-cell">
            <div class="kpi-label">FCF Yield</div>
            <div class="kpi-value">{{ fmt_pct(tf.fcf_yield) }}</div>
          </div>
          {% if sym_short %}
          <div class="kpi-cell">
            <div class="kpi-label">Short Float %</div>
            {% if sym_short.short_percent_float is not none %}
            {% set sp = sym_short.short_percent_float %}
            <div class="kpi-value {{ 'short-high' if sp > 0.10 else ('short-mid' if sp > 0.05 else 'short-low') }}">
              {{ "%.1f"|format(sp * 100) }}%
            </div>
            {% elif sym_short.short_percent_outstanding is not none %}
            {% set sp = sym_short.short_percent_outstanding %}
            <div class="kpi-value {{ 'short-high' if sp > 0.10 else ('short-mid' if sp > 0.05 else 'short-low') }}">
              {{ "%.1f"|format(sp * 100) }}%
            </div>
            {% else %}
            <div class="kpi-value">—</div>
            {% endif %}
          </div>
          {% endif %}
        </div>

        <!-- Multi-year table -->
        {% if tf.metrics_by_year %}
        <table class="fin-table">
          <thead>
            <tr>
              <th>Metric</th>
              {% for m in tf.metrics_by_year %}<th>{{ m.year }}</th>{% endfor %}
            </tr>
          </thead>
          <tbody>
            <tr><td>Revenue</td>{% for m in tf.metrics_by_year %}<td>{{ fmt_b(m.revenue) }}</td>{% endfor %}</tr>
            <tr><td>Gross Margin</td>{% for m in tf.metrics_by_year %}<td>{{ fmt_pct(m.gross_margin) }}</td>{% endfor %}</tr>
            <tr><td>Operating Margin</td>{% for m in tf.metrics_by_year %}<td>{{ fmt_pct(m.operating_margin) }}</td>{% endfor %}</tr>
            <tr><td>Net Margin</td>{% for m in tf.metrics_by_year %}<td>{{ fmt_pct(m.net_margin) }}</td>{% endfor %}</tr>
            <tr><td>Net Income</td>{% for m in tf.metrics_by_year %}<td>{{ fmt_b(m.net_income) }}</td>{% endfor %}</tr>
            <tr><td>Free Cash Flow</td>{% for m in tf.metrics_by_year %}<td>{{ fmt_b(m.free_cash_flow) }}</td>{% endfor %}</tr>
            <tr><td>Total Debt</td>{% for m in tf.metrics_by_year %}<td>{{ fmt_b(m.total_debt) }}</td>{% endfor %}</tr>
            <tr><td>Cash &amp; Equiv.</td>{% for m in tf.metrics_by_year %}<td>{{ fmt_b(m.cash_and_equivalents) }}</td>{% endfor %}</tr>
          </tbody>
        </table>
        {% endif %}

        <div class="ai-block">
          <div class="ai-label">AI Analysis</div>
          <div class="ai-text">{{ tf.ai_analysis }}</div>
        </div>
      </div>
    </div>
    {% endif %}

    <!-- ── SECTION: PRODUCT ANALYSIS ── -->
    {% if tp %}
    <div class="section" id="sec-product-{{ tr.symbol }}">
      <div class="section-header">
        <span class="section-title">Product &amp; Business Momentum</span>
        {% if tp.sector %}<span style="font-size:11px;color:var(--text-muted);">{{ tp.sector }}{% if tp.industry %} &middot; {{ tp.industry }}{% endif %}</span>{% endif %}
      </div>
      <div class="card">

        <!-- Key metrics strip -->
        <div class="product-grid">
          <!-- Revenue growth -->
          <div class="product-metric-card">
            <div class="product-metric-label">TTM Revenue Growth</div>
            {% if tp.revenue_growth is not none %}
            <div class="product-metric-value {% if tp.revenue_growth >= 0 %}upside-positive{% else %}upside-negative{% endif %}">
              {{ "%.1f"|format(tp.revenue_growth * 100) }}%
            </div>
            {% else %}<div class="product-metric-value">N/A</div>{% endif %}
            <div class="product-metric-sub">Year-over-year</div>
          </div>
          <!-- Earnings growth -->
          <div class="product-metric-card">
            <div class="product-metric-label">TTM Earnings Growth</div>
            {% if tp.earnings_growth is not none %}
            <div class="product-metric-value {% if tp.earnings_growth >= 0 %}upside-positive{% else %}upside-negative{% endif %}">
              {{ "%.1f"|format(tp.earnings_growth * 100) }}%
            </div>
            {% else %}<div class="product-metric-value">N/A</div>{% endif %}
            <div class="product-metric-sub">Year-over-year</div>
          </div>
          <!-- Gross margin -->
          <div class="product-metric-card">
            <div class="product-metric-label">Gross Margin</div>
            {% if tp.gross_margins is not none %}
            <div class="product-metric-value">{{ "%.1f"|format(tp.gross_margins * 100) }}%</div>
            {% else %}<div class="product-metric-value">N/A</div>{% endif %}
            {% if tp.operating_margins is not none %}
            <div class="product-metric-sub">Op. margin: {{ "%.1f"|format(tp.operating_margins * 100) }}%</div>
            {% endif %}
          </div>
          <!-- Return on equity -->
          <div class="product-metric-card">
            <div class="product-metric-label">Return on Equity</div>
            {% if tp.return_on_equity is not none %}
            <div class="product-metric-value {% if tp.return_on_equity >= 0 %}upside-positive{% else %}upside-negative{% endif %}">
              {{ "%.1f"|format(tp.return_on_equity * 100) }}%
            </div>
            {% else %}<div class="product-metric-value">N/A</div>{% endif %}
            {% if tp.peg_ratio is not none %}
            <div class="product-metric-sub">PEG ratio: {{ "%.2f"|format(tp.peg_ratio) }}</div>
            {% endif %}
          </div>
          <!-- Forward EPS -->
          <div class="product-metric-card">
            <div class="product-metric-label">Forward EPS</div>
            {% if tp.eps_forward is not none %}
            <div class="product-metric-value">${{ "%.2f"|format(tp.eps_forward) }}</div>
            {% else %}<div class="product-metric-value">N/A</div>{% endif %}
            {% if tp.price_to_sales is not none %}
            <div class="product-metric-sub">P/S: {{ "%.1f"|format(tp.price_to_sales) }}x</div>
            {% endif %}
          </div>
          <!-- Consensus target -->
          <div class="product-metric-card">
            <div class="product-metric-label">Consensus Target</div>
            {% if tp.target_mean_price is not none %}
            <div class="product-metric-value">${{ "%.2f"|format(tp.target_mean_price) }}</div>
            {% if tp.current_price and tp.current_price > 0 %}
            {% set upside = (tp.target_mean_price - tp.current_price) / tp.current_price %}
            <div class="product-metric-sub {% if upside >= 0 %}upside-positive{% else %}upside-negative{% endif %}">
              {{ "%+.1f"|format(upside * 100) }}% vs current
            </div>
            {% endif %}
            {% else %}<div class="product-metric-value">N/A</div>{% endif %}
          </div>
        </div>

        <!-- Segment / Product revenue breakdown -->
        {% set seg_list = tp.segments[0] if tp.segments else [] %}
        {% set value_driver = tp.segments[1] if tp.segments and tp.segments|length > 1 else "" %}
        {% if seg_list %}
        {% set seg_colors = ['#2563eb','#16a34a','#d97706','#7c3aed','#0891b2','#9ca3af'] %}
        <div class="seg-list">
          <div style="font-size:11px;font-weight:700;color:var(--text-secondary);margin-bottom:4px;text-transform:uppercase;letter-spacing:0.4px;">Revenue Breakdown by Segment</div>
          {% for seg in seg_list %}
          {% set color = seg_colors[loop.index0 % seg_colors|length] %}
          <div>
            <div class="seg-row">
              <div class="seg-name">{{ seg.name }}</div>
              <div class="seg-bar-track">
                <div class="seg-bar-fill" style="width:{{ seg.pct | default(0) }}%;background:{{ color }};opacity:0.8;"></div>
              </div>
              <div class="seg-pct">{{ seg.pct | default(0) }}%</div>
              {% if seg.trend %}
              <span class="seg-trend seg-trend-{{ seg.trend }}">{{ seg.trend }}</span>
              {% endif %}
            </div>
            {% if seg.description %}
            <div class="seg-desc">{{ seg.description }}</div>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% if value_driver %}
        <div class="value-driver-note">⚡ <strong>Key value driver:</strong> {{ value_driver }}</div>
        {% endif %}
        {% endif %}

        <!-- Quarterly revenue bar chart -->
        {% if tp.quarterly_revenue %}
        <div class="qrev-chart" style="border-top:1px solid var(--border);">
          <div style="font-size:11px;font-weight:700;color:var(--text-secondary);margin-bottom:10px;text-transform:uppercase;letter-spacing:0.4px;">Quarterly Revenue Trend</div>
          {% set max_rev = tp.quarterly_revenue | map(attribute='revenue') | select | list %}
          {% if max_rev %}
          {% set max_val = max_rev | max %}
          <div class="qrev-bars">
            {% for q in tp.quarterly_revenue %}
            {% set bar_h = ((q.revenue / max_val * 72) | int) if q.revenue and max_val else 4 %}
            <div class="qrev-bar-wrap">
              <div style="font-size:8px;color:var(--text-muted);text-align:center;margin-bottom:2px;">
                {% if q.revenue %}${{ "%.1f"|format(q.revenue / 1e9) }}B{% endif %}
              </div>
              <div class="qrev-bar" style="height:{{ bar_h }}px;"
                   title="{{ q.period }}{% if q.revenue %}: ${{ '%.2f'|format(q.revenue/1e9) }}B{% endif %}{% if q.yoy_revenue_growth %} ({{ '%+.1f'|format(q.yoy_revenue_growth*100) }}% YoY){% endif %}">
              </div>
              <div class="qrev-label">{{ q.period }}</div>
              {% if q.yoy_revenue_growth is not none %}
              <div class="qrev-yoy {% if q.yoy_revenue_growth >= 0 %}pos{% else %}neg{% endif %}">
                {{ "%+.0f"|format(q.yoy_revenue_growth * 100) }}%
              </div>
              {% else %}
              <div class="qrev-yoy">&nbsp;</div>
              {% endif %}
            </div>
            {% endfor %}
          </div>
          {% endif %}
        </div>
        {% endif %}

        <!-- Earnings beat / miss -->
        {% if tp.earnings_history %}
        <div style="border-top:1px solid var(--border);padding:14px 16px 0;">
          <div style="font-size:11px;font-weight:700;color:var(--text-secondary);margin-bottom:10px;text-transform:uppercase;letter-spacing:0.4px;">EPS Estimate vs Actual</div>
        </div>
        <table class="beat-table">
          <thead>
            <tr>
              <th>Quarter</th>
              <th>Estimate</th>
              <th>Actual</th>
              <th>Surprise</th>
            </tr>
          </thead>
          <tbody>
            {% for beat in tp.earnings_history %}
            <tr>
              <td>{{ beat.period }}</td>
              <td>{% if beat.eps_estimate is not none %}${{ "%.2f"|format(beat.eps_estimate) }}{% else %}—{% endif %}</td>
              <td>{% if beat.eps_actual is not none %}${{ "%.2f"|format(beat.eps_actual) }}{% else %}—{% endif %}</td>
              <td>
                {% if beat.surprise_pct is not none %}
                {% if beat.surprise_pct > 1 %}
                <span class="beat-pill beat-pos">+{{ "%.1f"|format(beat.surprise_pct) }}%</span>
                {% elif beat.surprise_pct < -1 %}
                <span class="beat-pill beat-neg">{{ "%.1f"|format(beat.surprise_pct) }}%</span>
                {% else %}
                <span class="beat-pill beat-neutral">In-line</span>
                {% endif %}
                {% else %}—{% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% endif %}

        <!-- AI product analysis -->
        <div class="ai-block">
          <div class="ai-label" style="display:flex;align-items:center;justify-content:space-between;">
            <span>AI Product &amp; Catalyst Analysis</span>
            {% if tp.recommendation %}
            <span class="revision-badge {% if 'buy' in tp.recommendation or 'strong' in tp.recommendation %}revision-up{% elif 'sell' in tp.recommendation %}revision-down{% else %}revision-neutral{% endif %}">
              {{ tp.recommendation | upper }}
            </span>
            {% endif %}
          </div>
          <div class="ai-text">{{ tp.ai_analysis }}</div>
        </div>

      </div>
    </div>
    {% endif %}

    <!-- ── SECTION: INSIDER TRANSACTIONS ── -->
    {% if sym_insider %}
    <div class="section" id="sec-insider-{{ tr.symbol }}">
      <div class="section-header">
        <span class="section-title" data-i18n="insider_txns">Insider Transactions</span>
      </div>
      <div class="card">
        <table class="insider-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Type</th>
              <th>Shares</th>
              <th>Price</th>
