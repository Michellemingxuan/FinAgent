const ADD_STOCK_PAT_KEY = 'finagent_add_stock_pat';
(function initAddStock() {
  const saved = localStorage.getItem(ADD_STOCK_PAT_KEY);
  if (saved) {
    const el = document.getElementById('addStockPat');
    if (el) el.value = saved;
    const cb = document.getElementById('addStockRemember');
    if (cb) cb.checked = true;
  }
})();

{% if github_repo %}
async function submitAddStock() {
  const REPO = "{{ github_repo }}";
  const WORKFLOW = "generate_report.yml";
  const ticker = (document.getElementById('newTicker').value || '').trim().toUpperCase();
  const pat = (document.getElementById('addStockPat').value || '').trim();
  const remember = document.getElementById('addStockRemember').checked;
  const statusEl = document.getElementById('addStockStatus');
  const btn = document.getElementById('addStockSubmit');

  if (!ticker) { showAddStatus('error', currentLang === 'zh' ? '请输入股票代码。' : 'Please enter a ticker symbol.'); return; }
  if (!pat) { showAddStatus('error', currentLang === 'zh' ? '请输入 GitHub PAT。' : 'Please enter your GitHub PAT.'); return; }

  if (remember) localStorage.setItem(ADD_STOCK_PAT_KEY, pat);
  else localStorage.removeItem(ADD_STOCK_PAT_KEY);

  btn.disabled = true;
  btn.textContent = currentLang === 'zh' ? '触发中…' : 'Triggering…';
  showAddStatus('running', currentLang === 'zh' ? '正在发送请求到 GitHub Actions…' : 'Sending request to GitHub Actions…');

  try {
    const resp = await fetch(
      `https://api.github.com/repos/${REPO}/actions/workflows/${WORKFLOW}/dispatches`,
      {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${pat}`,
          'Accept': 'application/vnd.github+json',
          'X-GitHub-Api-Version': '2022-11-28',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ ref: 'main', inputs: { section: 'all', new_ticker: ticker } }),
      }
    );

    if (resp.status === 204) {
      showAddStatus('success', currentLang === 'zh'
        ? `✓ 已触发! ${ticker} 的报告将在约 3 分钟后生成。届时请刷新页面。`
        : `✓ Triggered! Report for ${ticker} will be ready in ~3 minutes. Refresh the page afterwards.`);
      btn.textContent = '✓';
      setTimeout(() => { btn.disabled = false; btn.textContent = currentLang === 'zh' ? '添加并生成' : 'Add & Generate'; }, 30000);
    } else if (resp.status === 401) {
      showAddStatus('error', currentLang === 'zh' ? 'Token 无效或缺少 workflow 权限。' : 'Invalid token or missing workflow scope.');
      btn.disabled = false; btn.textContent = currentLang === 'zh' ? '添加并生成' : 'Add & Generate';
    } else {
      const body = await resp.text();
      showAddStatus('error', `GitHub ${resp.status}: ${body.slice(0, 120)}`);
      btn.disabled = false; btn.textContent = currentLang === 'zh' ? '添加并生成' : 'Add & Generate';
    }
  } catch (err) {
    showAddStatus('error', `Network error: ${err.message}`);
    btn.disabled = false; btn.textContent = currentLang === 'zh' ? '添加并生成' : 'Add & Generate';
  }
}
{% endif %}

function showAddStatus(type, msg) {
  const el = document.getElementById('addStockStatus');
  if (!el) return;
  el.className = `modal-status ${type}`;
  el.textContent = msg;
}
</script>

