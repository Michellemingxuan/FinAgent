    {% endif %}

    <!-- ── SECTION: SUPPLY CHAIN MAP ── -->
    {% set sc = ctx.supply_chain_detail.get(tr.symbol, {}) %}
    <div class="section" id="sec-sc-{{ tr.symbol }}">
      <div class="section-header">
        <span class="section-title" data-i18n="supply_chain_map">Supply Chain Map</span>
      </div>
      <div class="card">
        {% if sc and (sc.get('upstream') or sc.get('downstream')) %}
        <div class="sc-diagram-wrap">
          <svg class="sc-svg" id="sc-svg-{{ tr.symbol }}" height="1" xmlns="http://www.w3.org/2000/svg"></svg>
        </div>
        {% if sc.get('supply_chain_summary') %}
        <div class="sc-summary">{{ sc.supply_chain_summary }}</div>
        {% endif %}
        <script>
        (function() {
          var sym = {{ tr.symbol | tojson }};
          var sc = {{ sc | tojson }};
          var upstream = sc.upstream || [];
          var downstream = sc.downstream || [];
          var watchlist = {{ ctx.watchlist_symbols | tojson }};
          var svgEl = document.getElementById('sc-svg-' + sym);
          if (!svgEl) return;

          var NODE_W = 148, NODE_H = 58, NODE_RX = 7;
          var COL_GAP = 80;
          var ROW_GAP = 14;
          var CENTER_W = 110, CENTER_H = 60;

          var criticColor = {
            'high': {stroke: '#dc2626', fill: '#fef2f2'},
            'medium': {stroke: '#ea580c', fill: '#fff7ed'},
            'low': {stroke: '#9ca3af', fill: '#f9fafb'}
          };
          var downColor = {
            'high': {stroke: '#16a34a', fill: '#f0fdf4'},
            'medium': {stroke: '#0d9488', fill: '#f0fdfa'},
            'low': {stroke: '#9ca3af', fill: '#f9fafb'}
          };

          var maxRows = Math.max(upstream.length, downstream.length, 1);
          var totalH = Math.max(maxRows * (NODE_H + ROW_GAP) - ROW_GAP, CENTER_H) + 40;
          var totalW = NODE_W + COL_GAP + CENTER_W + COL_GAP + NODE_W + 40;

          svgEl.setAttribute('viewBox', '0 0 ' + totalW + ' ' + totalH);
          svgEl.setAttribute('height', totalH);

          function svgEl_(tag, attrs) {
            var el = document.createElementNS('http://www.w3.org/2000/svg', tag);
            for (var k in attrs) el.setAttribute(k, attrs[k]);
            return el;
          }
          function addText(parent, x, y, text, style) {
            var t = svgEl_('text', {x: x, y: y, style: style || ''});
            t.textContent = text;
            parent.appendChild(t);
          }

          var cx = NODE_W + COL_GAP + 20;
          var cy = totalH / 2 - CENTER_H / 2;

          // Draw center node
          var centerG = svgEl_('g', {});
          centerG.appendChild(svgEl_('rect', {
            x: cx, y: cy, width: CENTER_W, height: CENTER_H, rx: NODE_RX,
            fill: '#eff6ff', stroke: '#2563eb', 'stroke-width': 2
          }));
          addText(centerG, cx + CENTER_W/2, cy + 22, sym, 'font-size:14px;font-weight:800;fill:#1d4ed8;text-anchor:middle;');
          svgEl.appendChild(centerG);

          function drawNodes(nodes, isLeft, colorMap) {
            var colX = isLeft ? 20 : cx + CENTER_W + COL_GAP;
            var totalNodesH = nodes.length * NODE_H + (nodes.length - 1) * ROW_GAP;
            var startY = totalH / 2 - totalNodesH / 2;
            nodes.forEach(function(node, i) {
              var ny = startY + i * (NODE_H + ROW_GAP);
              var nc = colorMap[node.criticality] || colorMap['low'];
              var isWatched = watchlist.indexOf(node.ticker) !== -1;
              var g = svgEl_('g', isWatched ? {style: 'cursor:pointer;'} : {});
              if (isWatched) {
                g.addEventListener('click', function() { switchToTab('stock-' + node.ticker); });
              }
              g.appendChild(svgEl_('rect', {
                x: colX, y: ny, width: NODE_W, height: NODE_H, rx: NODE_RX,
                fill: isWatched ? '#eff6ff' : nc.fill,
                stroke: isWatched ? '#2563eb' : nc.stroke,
                'stroke-width': isWatched ? 2 : 1.5,
                'stroke-dasharray': isWatched ? 'none' : 'none'
              }));
              var revPct = node.revenue_pct ? node.revenue_pct : 0;
              var pctLabel = revPct > 0 ? revPct + '%' : '';
              // Ticker + pct on same line
              var tickerLabel = (node.ticker || '') + (pctLabel ? '  ' + pctLabel : '');
              addText(g, colX + NODE_W/2, ny + 17, tickerLabel,
                'font-size:11px;font-weight:700;fill:' + (isWatched ? '#1d4ed8' : '#111827') + ';text-anchor:middle;');
              var nameText = (node.name || '').substring(0, 22);
              addText(g, colX + NODE_W/2, ny + 30, nameText,
                'font-size:9px;fill:#6b7280;text-anchor:middle;');
              if (isWatched) {
                addText(g, colX + NODE_W/2, ny + 48, '↗ view report',
                  'font-size:8px;fill:#2563eb;text-anchor:middle;font-style:italic;');
              } else {
                var relText = (node.relationship || '').substring(0, 28);
                addText(g, colX + NODE_W/2, ny + 44, relText,
                  'font-size:8px;fill:#9ca3af;text-anchor:middle;');
                if (pctLabel) {
                  addText(g, colX + NODE_W/2, ny + 54, '~' + pctLabel + ' of rev/cost',
                    'font-size:8px;fill:' + nc.stroke + ';text-anchor:middle;font-weight:600;');
                }
              }
              svgEl.appendChild(g);

              // Arrow — thickness scales with revenue_pct
              var arrowW = revPct > 0 ? Math.max(1, Math.min(4, revPct / 8)) : 1.2;
              var nodeRightX = colX + NODE_W;
              var nodeMidY = ny + NODE_H / 2;
              var centerMidY = cy + CENTER_H / 2;
              var p1x, p1y, p2x, p2y, cp1x, cp1y, cp2x, cp2y;
              if (isLeft) {
                p1x = nodeRightX; p1y = nodeMidY;
                p2x = cx; p2y = centerMidY;
              } else {
                p1x = cx + CENTER_W; p1y = centerMidY;
                p2x = colX; p2y = nodeMidY;
              }
              cp1x = p1x + (p2x - p1x) * 0.45; cp1y = p1y;
              cp2x = p1x + (p2x - p1x) * 0.55; cp2y = p2y;
              var path = svgEl_('path', {
                d: 'M' + p1x + ',' + p1y + ' C' + cp1x + ',' + cp1y + ' ' + cp2x + ',' + cp2y + ' ' + p2x + ',' + p2y,
                fill: 'none', stroke: nc.stroke, 'stroke-width': arrowW,
                'marker-end': isLeft ? 'url(#arrow-in)' : 'url(#arrow-out)',
                opacity: 0.6
              });
              svgEl.insertBefore(path, svgEl.firstChild);
            });
          }

          // Arrowhead markers
          var defs = svgEl_('defs', {});
          ['arrow-in', 'arrow-out'].forEach(function(id) {
            var marker = svgEl_('marker', {id: id, markerWidth: 6, markerHeight: 6,
              refX: 5, refY: 3, orient: 'auto'});
            var poly = svgEl_('polygon', {points: '0 0, 6 3, 0 6', fill: '#9ca3af'});
            marker.appendChild(poly);
            defs.appendChild(marker);
          });
          svgEl.insertBefore(defs, svgEl.firstChild);

          drawNodes(upstream, true, criticColor);
          drawNodes(downstream, false, downColor);
        })();
        </script>
        {% else %}
        <div class="sc-empty">No supply chain data yet. Run <code>python main.py --refresh-supply-chain</code> to discover relationships.</div>
        {% endif %}
      </div>
    </div>

      </div>{# end tab-main #}
    </div>{# end tab-layout #}

