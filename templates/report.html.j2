    {% if ctx.supply_chain_detail %}
    <div class="section">
      <div class="section-header"><span class="section-title" data-i18n="supply_chain_network">Supply Chain Network</span></div>
      <div class="card">
        <div class="sc-diagram-wrap">
          <svg id="sc-network-svg" class="sc-svg" height="1" xmlns="http://www.w3.org/2000/svg"></svg>
        </div>
        <script>
        (function() {
          var scDetail = {{ ctx.supply_chain_detail | tojson }};
          var symbols = {{ ctx.watchlist_symbols | tojson }};
          var svgEl = document.getElementById('sc-network-svg');
          if (!svgEl || !symbols.length) return;

          var NODE_W = 130, NODE_H = 48, NODE_RX = 7;
          var CENTER_W = 100, CENTER_H = 56;
          var COL_GAP = 70, ROW_GAP = 10;

          // Collect all upstream/downstream nodes across all tickers
          var upstreamSet = {}, downstreamSet = {};
          symbols.forEach(function(sym) {
            var sc = scDetail[sym] || {};
            (sc.upstream || []).forEach(function(n) { upstreamSet[n.ticker] = n; });
            (sc.downstream || []).forEach(function(n) { downstreamSet[n.ticker] = n; });
          });
          // Remove portfolio tickers from satellite sets
          symbols.forEach(function(sym) { delete upstreamSet[sym]; delete downstreamSet[sym]; });

          var upNodes = Object.values(upstreamSet);
          var downNodes = Object.values(downstreamSet);
          var centerNodes = symbols;

          var maxRows = Math.max(upNodes.length, downNodes.length, centerNodes.length, 1);
          var totalH = maxRows * (NODE_H + ROW_GAP) - ROW_GAP + 40;
          var totalW = NODE_W + COL_GAP + CENTER_W + COL_GAP + NODE_W + 40;
          svgEl.setAttribute('viewBox', '0 0 ' + totalW + ' ' + totalH);
          svgEl.setAttribute('height', totalH);

          function svgEl_(tag, attrs) {
            var el = document.createElementNS('http://www.w3.org/2000/svg', tag);
            for (var k in attrs) el.setAttribute(k, attrs[k]);
            return el;
          }
          function addText(parent, x, y, text, style) {
            var t = svgEl_('text', {x: x, y: y, style: style || ''});
            t.textContent = text;
            parent.appendChild(t);
          }

          var criticColor = {
            'high': {stroke: '#dc2626', fill: '#fef2f2'},
            'medium': {stroke: '#ea580c', fill: '#fff7ed'},
            'low': {stroke: '#9ca3af', fill: '#f9fafb'}
          };
          var downColor = {
            'high': {stroke: '#16a34a', fill: '#f0fdf4'},
            'medium': {stroke: '#0d9488', fill: '#f0fdfa'},
            'low': {stroke: '#9ca3af', fill: '#f9fafb'}
          };

          // Draw center column (portfolio tickers)
          var cx = NODE_W + COL_GAP + 20;
          var centerStartY = totalH / 2 - (centerNodes.length * (CENTER_H + ROW_GAP) - ROW_GAP) / 2;
          var centerMids = {};
          centerNodes.forEach(function(sym, i) {
            var cy = centerStartY + i * (CENTER_H + ROW_GAP);
            centerMids[sym] = cy + CENTER_H / 2;
            var g = svgEl_('g', {});
            g.appendChild(svgEl_('rect', {
              x: cx, y: cy, width: CENTER_W, height: CENTER_H, rx: NODE_RX,
              fill: '#eff6ff', stroke: '#2563eb', 'stroke-width': 2
            }));
            addText(g, cx + CENTER_W/2, cy + 24, sym,
              'font-size:12px;font-weight:800;fill:#1d4ed8;text-anchor:middle;');
            svgEl.appendChild(g);
          });

          // Arrowhead markers
          var defs = svgEl_('defs', {});
          ['arr-in','arr-out'].forEach(function(id) {
            var m = svgEl_('marker', {id: id, markerWidth: 6, markerHeight: 6,
              refX: 5, refY: 3, orient: 'auto'});
            m.appendChild(svgEl_('polygon', {points: '0 0, 6 3, 0 6', fill: '#9ca3af'}));
            defs.appendChild(m);
          });
          svgEl.insertBefore(defs, svgEl.firstChild);

          function drawSatellites(nodes, isLeft, colorMap) {
            var colX = isLeft ? 20 : cx + CENTER_W + COL_GAP;
            var totalNodesH = nodes.length * NODE_H + (nodes.length - 1) * ROW_GAP;
            var startY = totalH / 2 - totalNodesH / 2;
            nodes.forEach(function(node, i) {
              var ny = startY + i * (NODE_H + ROW_GAP);
              var nc = colorMap[node.criticality] || colorMap['low'];
              var g = svgEl_('g', {});
              g.appendChild(svgEl_('rect', {
                x: colX, y: ny, width: NODE_W, height: NODE_H, rx: NODE_RX,
                fill: nc.fill, stroke: nc.stroke, 'stroke-width': 1.5
              }));
              addText(g, colX + NODE_W/2, ny + 16, node.ticker || '',
                'font-size:10px;font-weight:700;fill:#111827;text-anchor:middle;');
              addText(g, colX + NODE_W/2, ny + 29, (node.name || '').substring(0, 20),
                'font-size:8px;fill:#6b7280;text-anchor:middle;');
              addText(g, colX + NODE_W/2, ny + 41, (node.relationship || '').substring(0, 24),
                'font-size:7px;fill:#9ca3af;text-anchor:middle;');
              svgEl.appendChild(g);

              var nodeMidY = ny + NODE_H / 2;
              // Draw arrows to all related center tickers
              symbols.forEach(function(sym) {
                var sc = scDetail[sym] || {};
                var list = isLeft ? (sc.upstream || []) : (sc.downstream || []);
                var found = list.find(function(x) { return x.ticker === node.ticker; });
                if (!found) return;
                var cmy = centerMids[sym];
                var p1x, p1y, p2x, p2y;
                if (isLeft) {
                  p1x = colX + NODE_W; p1y = nodeMidY;
                  p2x = cx; p2y = cmy;
                } else {
                  p1x = cx + CENTER_W; p1y = cmy;
                  p2x = colX; p2y = nodeMidY;
                }
                var cp1x = p1x + (p2x - p1x) * 0.45, cp1y = p1y;
                var cp2x = p1x + (p2x - p1x) * 0.55, cp2y = p2y;
                var path = svgEl_('path', {
                  d: 'M'+p1x+','+p1y+' C'+cp1x+','+cp1y+' '+cp2x+','+cp2y+' '+p2x+','+p2y,
                  fill: 'none', stroke: nc.stroke, 'stroke-width': 1,
                  'marker-end': isLeft ? 'url(#arr-in)' : 'url(#arr-out)',
                  opacity: 0.4
                });
                svgEl.insertBefore(path, svgEl.firstChild);
              });
            });
          }

          drawSatellites(upNodes, true, criticColor);
          drawSatellites(downNodes, false, downColor);
        })();
        </script>
      </div>
    </div>
    {% endif %}

    <!-- Geopolitical themes — full list -->
    {% if ctx.geopolitical_themes %}
    <div class="section">
      <div class="section-header"><span class="section-title" data-i18n="geo_risk_themes">Geopolitical Risk Themes</span></div>
