    {% set ticker_geo = ctx.geopolitical_themes | selectattr("affected_tickers", "containing", tr.symbol) | list %}
    {% if ticker_geo %}
    <div class="section" id="sec-geo-{{ tr.symbol }}">
      <div class="section-header">
        <span class="section-title" data-i18n="geo_exposure">Geopolitical Exposure</span>
      </div>
      <div class="card">
        {% for theme in ticker_geo %}
        <div class="geo-theme">
