// ── Tab drag-to-reorder ───────────────────────────────────────────
const TAB_ORDER_KEY = 'finagent_tab_order';
const TAB_HIDDEN_KEY = 'finagent_tab_hidden';
let dragSrcTab = null;

function initTabs() {
  restoreTabState();
  const tabBar = document.getElementById('tabBar');
  tabBar.addEventListener('dragstart', e => {
    const tab = e.target.closest('.tab[data-symbol]');
    if (!tab) return;
    dragSrcTab = tab;
    tab.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
  });
  tabBar.addEventListener('dragend', e => {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('dragging', 'drag-over'));
    dragSrcTab = null;
    saveTabOrder();
  });
  tabBar.addEventListener('dragover', e => {
    e.preventDefault();
    const target = e.target.closest('.tab[data-symbol]');
    if (!target || target === dragSrcTab) return;
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('drag-over'));
    target.classList.add('drag-over');
    e.dataTransfer.dropEffect = 'move';
  });
  tabBar.addEventListener('dragleave', e => {
    const target = e.target.closest('.tab[data-symbol]');
    if (target) target.classList.remove('drag-over');
  });
  tabBar.addEventListener('drop', e => {
    e.preventDefault();
    const target = e.target.closest('.tab[data-symbol]');
    if (!target || !dragSrcTab || target === dragSrcTab) return;
    // Insert before or after depending on mouse position
    const rect = target.getBoundingClientRect();
    const insertBefore = e.clientX < rect.left + rect.width / 2;
    target.classList.remove('drag-over');
    if (insertBefore) tabBar.insertBefore(dragSrcTab, target);
    else tabBar.insertBefore(dragSrcTab, target.nextSibling);
    saveTabOrder();
  });
}

function saveTabOrder() {
  const order = Array.from(document.querySelectorAll('#tabBar .tab[data-symbol]'))
    .map(t => t.dataset.symbol);
  localStorage.setItem(TAB_ORDER_KEY, JSON.stringify(order));
}

function restoreTabState() {
  const tabBar = document.getElementById('tabBar');
  const macroTab = tabBar.querySelector('[data-tab="macro"]');
  const restoreBtn = document.getElementById('tabRestore');

  // Restore order
  try {
    const order = JSON.parse(localStorage.getItem(TAB_ORDER_KEY) || '[]');
    if (order.length) {
      order.forEach(sym => {
        const t = tabBar.querySelector(`.tab[data-symbol="${sym}"]`);
        if (t) tabBar.insertBefore(t, macroTab);
      });
    }
  } catch (_) {}

  // Restore hidden
  try {
    const hidden = JSON.parse(localStorage.getItem(TAB_HIDDEN_KEY) || '[]');
    hidden.forEach(sym => hideTabSilent(sym));
    updateRestoreButton();
  } catch (_) {}
}

function hideTabSilent(sym) {
  const tab = document.querySelector(`#tabBar .tab[data-symbol="${sym}"]`);
  const content = document.getElementById('tab-stock-' + sym);
  if (tab) tab.style.display = 'none';
  if (content) content.style.display = 'none';
}

function closeTab(e, sym) {
  e.stopPropagation();
  const tab = document.querySelector(`#tabBar .tab[data-symbol="${sym}"]`);
  const content = document.getElementById('tab-stock-' + sym);
  if (tab) {
    // If this tab is active, activate the next visible tab
    if (tab.classList.contains('active')) {
      const allTabs = Array.from(document.querySelectorAll('#tabBar .tab'));
      const visible = allTabs.filter(t => t.style.display !== 'none' && t !== tab);
      if (visible.length) switchToTab(visible[0].dataset.tab);
    }
    tab.style.display = 'none';
  }
  if (content) { content.classList.remove('active'); content.style.display = 'none'; }
  // Save hidden list
  const hidden = JSON.parse(localStorage.getItem(TAB_HIDDEN_KEY) || '[]');
  if (!hidden.includes(sym)) hidden.push(sym);
  localStorage.setItem(TAB_HIDDEN_KEY, JSON.stringify(hidden));
  updateRestoreButton();
}

function restoreAllTabs() {
  localStorage.removeItem(TAB_HIDDEN_KEY);
  document.querySelectorAll('#tabBar .tab[data-symbol]').forEach(t => t.style.display = '');
  document.querySelectorAll('.tab-content[id^="tab-stock-"]').forEach(c => c.style.display = '');
  updateRestoreButton();
}

function updateRestoreButton() {
  const hidden = JSON.parse(localStorage.getItem(TAB_HIDDEN_KEY) || '[]');
  const btn = document.getElementById('tabRestore');
  const lbl = document.getElementById('tabRestoreLabel');
  if (!btn) return;
  if (hidden.length) {
    btn.classList.add('has-hidden');
    if (lbl) lbl.textContent = `+${hidden.length} hidden`;
  } else {
    btn.classList.remove('has-hidden');
  }
}

// ── Add / Remove Stock ────────────────────────────────────────────
const ADD_STOCK_PAT_KEY = 'finagent_add_stock_pat';
const ADMIN_KEY = 'finagent_admin';
let _pollTimer = null;
let _modalMode = 'add';   // 'add' | 'remove' | 'refresh' | 'unlock'
let _removeSym = '';

function _i18n(key) {
  const s = I18N[currentLang] || I18N.en || {};
  return (s[key] !== undefined ? s[key] : (I18N.en[key] || key));
}

function _submitLabel() {
  if (_modalMode === 'remove') return _i18n('remove_rebuild');
  if (_modalMode === 'refresh') return _i18n('refresh_now');
  if (_modalMode === 'unlock') return _i18n('admin_unlock');
  return _i18n('add_generate');
}

// ── Admin mode (owner-only controls) ──────────────────────────────
function isAdmin() {
  return localStorage.getItem(ADMIN_KEY) === '1' && !!localStorage.getItem(ADD_STOCK_PAT_KEY);
}

function applyAdminMode() {
  const on = isAdmin();
  document.body.classList.toggle('admin-mode', on);
  const btn = document.getElementById('adminToggle');
  if (btn) {
    btn.classList.toggle('is-admin', on);
    btn.title = on ? 'Owner mode on — click to sign out' : 'Owner sign-in';
  }
}

function toggleAdmin() {
  if (isAdmin()) {
    // Sign out: hide controls. Keep the saved token so re-unlock is quick.
    localStorage.removeItem(ADMIN_KEY);
    applyAdminMode();
  } else {
    openAdminUnlock();
  }
}

function openAdminUnlock() {
  _modalMode = 'unlock';
  _removeSym = '';
  document.getElementById('stockModalTitle').innerHTML = _i18n('admin_title');
  document.getElementById('stockModalDesc').innerHTML = _i18n('admin_desc');
  document.getElementById('tickerInputRow').style.display = 'none';
  const btn = document.getElementById('addStockSubmit');
  if (btn) { btn.disabled = false; btn.textContent = _submitLabel(); btn.classList.remove('btn-danger'); }
  document.getElementById('addStockModal').classList.add('visible');
  initAddStock();
  showPatInput(); // always show the token field for sign-in
}

function _runNoun(ticker) {
  if (_modalMode === 'remove') return `${ticker} removal`;
  if (_modalMode === 'refresh') return 'full report generation';
  return `${ticker} report generation`;
}

function openRefreshReport() {
  if (!isAdmin()) { openAdminUnlock(); return; }
  _modalMode = 'refresh';
  _removeSym = '';
  document.getElementById('stockModalTitle').innerHTML = _i18n('refresh_report_title');
  document.getElementById('stockModalDesc').innerHTML = _i18n('refresh_report_desc');
  document.getElementById('tickerInputRow').style.display = 'none';
  const btn = document.getElementById('addStockSubmit');
  if (btn) { btn.disabled = false; btn.textContent = _submitLabel(); btn.classList.remove('btn-danger'); }
  document.getElementById('addStockModal').classList.add('visible');
  initAddStock();
}

function openAddStock() {
  if (!isAdmin()) { openAdminUnlock(); return; }
  _modalMode = 'add';
  _removeSym = '';
  document.getElementById('stockModalTitle').innerHTML = _i18n('add_stock_title');
  document.getElementById('stockModalDesc').innerHTML = _i18n('add_stock_desc');
  document.getElementById('tickerInputRow').style.display = '';
  const btn = document.getElementById('addStockSubmit');
  if (btn) { btn.disabled = false; btn.textContent = _submitLabel(); btn.classList.remove('btn-danger'); }
  document.getElementById('addStockModal').classList.add('visible');
  initAddStock();
}

function openRemoveStock(event, sym) {
  if (event) { event.stopPropagation(); event.preventDefault(); }
  if (!isAdmin()) { openAdminUnlock(); return; }
  _modalMode = 'remove';
  _removeSym = sym;
  document.getElementById('stockModalTitle').innerHTML = _i18n('remove_stock_title').replaceAll('{sym}', sym);
  document.getElementById('stockModalDesc').innerHTML = _i18n('remove_stock_desc').replaceAll('{sym}', sym);
  document.getElementById('tickerInputRow').style.display = 'none';
  const btn = document.getElementById('addStockSubmit');
  if (btn) { btn.disabled = false; btn.textContent = _submitLabel(); btn.classList.add('btn-danger'); }
  document.getElementById('addStockModal').classList.add('visible');
  initAddStock();
}

function initAddStock() {
  const saved = localStorage.getItem(ADD_STOCK_PAT_KEY);
  if (saved) {
    const savedRow = document.getElementById('tokenSavedRow');
    const inputSec = document.getElementById('tokenInputSection');
    if (savedRow) savedRow.style.display = 'flex';
    if (inputSec) inputSec.style.display = 'none';
  }
}

function showPatInput() {
  document.getElementById('tokenSavedRow').style.display = 'none';
  document.getElementById('tokenInputSection').style.display = 'block';
  document.getElementById('addStockPat').focus();
}

function closeAddStockModal() {
  document.getElementById('addStockModal').classList.remove('visible');
  // Reset to initial state
  const btn = document.getElementById('addStockSubmit');
  if (btn) { btn.disabled = false; btn.textContent = _submitLabel(); }
  document.getElementById('addStockActions').style.display = 'flex';
  document.getElementById('progressTrack').classList.remove('visible');
  showAddStatus('', '');
  if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }
}

function setProgressStep(step, state) {
  // state: 'active' | 'done' | 'failed' | ''
  const el = document.getElementById('pstep-' + step);
  if (!el) return;
  el.className = 'progress-step' + (state ? ' ' + state : '');
  const dot = el.querySelector('.step-dot');
  if (dot) dot.textContent = state === 'done' ? '✓' : state === 'failed' ? '✕' : ({ trigger:'1', queue:'2', run:'3', done:'4' }[step] || '?');
}

{% if github_repo %}
async function submitAddStock() {
  const REPO = "{{ github_repo }}";
  const WORKFLOW = "generate_report.yml";
  const isRemove = _modalMode === 'remove';
  const isRefresh = _modalMode === 'refresh';
  const isUnlock = _modalMode === 'unlock';
  const ticker = isRemove ? _removeSym : (isRefresh || isUnlock) ? '' : (document.getElementById('newTicker').value || '').trim().toUpperCase();
  const savedPat = localStorage.getItem(ADD_STOCK_PAT_KEY) || '';
  const inputEl = document.getElementById('addStockPat');
  const pat = (inputEl && inputEl.offsetParent !== null ? inputEl.value.trim() : '') || savedPat;
  const btn = document.getElementById('addStockSubmit');

  if (isUnlock) { await _doUnlock(REPO, pat, btn); return; }

  if (!isRefresh && !ticker) { showAddStatus('error', isRemove ? 'No ticker selected.' : 'Please enter a ticker symbol.'); return; }
  if (!pat) {
    showPatInput();
    showAddStatus('error', 'Please enter your GitHub Personal Access Token.');
    return;
  }

  // Save token
  localStorage.setItem(ADD_STOCK_PAT_KEY, pat);
  initAddStock();

  // Switch to progress UI
  btn.disabled = true;
  btn.textContent = 'Working…';
  document.getElementById('progressTrack').classList.add('visible');
  showAddStatus('', '');
  setProgressStep('trigger', 'active');
  setProgressStep('queue', '');
  setProgressStep('run', '');
  setProgressStep('done', '');

  const triggerTime = Date.now();

  try {
    const resp = await fetch(
      `https://api.github.com/repos/${REPO}/actions/workflows/${WORKFLOW}/dispatches`,
      {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${pat}`,
          'Accept': 'application/vnd.github+json',
          'X-GitHub-Api-Version': '2022-11-28',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ ref: 'main', inputs: isRemove ? { remove_ticker: ticker } : isRefresh ? { section: 'all' } : { section: 'all', new_ticker: ticker } }),
      }
    );

    if (resp.status === 401) {
      setProgressStep('trigger', 'failed');
      showAddStatus('error', 'Invalid token or missing workflow scope.');
      btn.disabled = false; btn.textContent = _submitLabel();
      return;
    }
    if (resp.status !== 204) {
      const body = await resp.text();
      setProgressStep('trigger', 'failed');
      showAddStatus('error', `GitHub error ${resp.status}: ${body.slice(0, 100)}`);
      btn.disabled = false; btn.textContent = _submitLabel();
      return;
    }

    setProgressStep('trigger', 'done');
    setProgressStep('queue', 'active');

    // Poll for the run status
    await new Promise(r => setTimeout(r, 4000)); // wait 4s for run to appear
    _pollForRun(REPO, pat, ticker, triggerTime);

  } catch (err) {
    setProgressStep('trigger', 'failed');
    showAddStatus('error', `Network error: ${err.message}`);
    btn.disabled = false; btn.textContent = _submitLabel();
  }
}

async function _doUnlock(repo, pat, btn) {
  if (!pat) { showPatInput(); showAddStatus('error', _i18n('admin_need_token')); return; }
  if (btn) { btn.disabled = true; btn.textContent = _i18n('admin_checking'); }
  try {
    const resp = await fetch(`https://api.github.com/repos/${repo}`, {
      headers: { 'Authorization': `Bearer ${pat}`, 'Accept': 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28' },
    });
    if (resp.status === 401) { showAddStatus('error', _i18n('admin_bad_token')); if (btn) { btn.disabled = false; btn.textContent = _submitLabel(); } return; }
    if (!resp.ok) { showAddStatus('error', _i18n('admin_no_access')); if (btn) { btn.disabled = false; btn.textContent = _submitLabel(); } return; }
    const data = await resp.json();
    if (!(data.permissions && (data.permissions.push || data.permissions.admin || data.permissions.maintain))) {
      showAddStatus('error', _i18n('admin_no_access'));
      if (btn) { btn.disabled = false; btn.textContent = _submitLabel(); }
      return;
    }
    // Classic tokens report their scopes; require 'workflow' (needed to dispatch
    // the report workflow). Fine-grained tokens omit this header — skip the check.
    const scopes = resp.headers.get('x-oauth-scopes');
    if (scopes !== null && !scopes.split(',').map(s => s.trim()).includes('workflow')) {
      showAddStatus('error', _i18n('admin_no_workflow'));
      if (btn) { btn.disabled = false; btn.textContent = _submitLabel(); }
      return;
    }
    // Verified owner — persist and reveal controls
    localStorage.setItem(ADD_STOCK_PAT_KEY, pat);
    localStorage.setItem(ADMIN_KEY, '1');
    applyAdminMode();
    closeAddStockModal();
  } catch (err) {
    showAddStatus('error', `Network error: ${err.message}`);
    if (btn) { btn.disabled = false; btn.textContent = _submitLabel(); }
  }
}

async function _pollForRun(repo, pat, ticker, triggerTime) {
  const headers = {
    'Authorization': `Bearer ${pat}`,
    'Accept': 'application/vnd.github+json',
    'X-GitHub-Api-Version': '2022-11-28',
  };
  let runId = null;
  let pollCount = 0;
  const MAX_POLLS = 60; // 10 min max

  _pollTimer = setInterval(async () => {
    pollCount++;
    if (pollCount > MAX_POLLS) {
      clearInterval(_pollTimer);
      setProgressStep('run', 'failed');
      showAddStatus('error', 'Timed out waiting for workflow. Check GitHub Actions.');
      return;
    }

    try {
      if (!runId) {
        // Find the run triggered after triggerTime
        const r = await fetch(`https://api.github.com/repos/${repo}/actions/workflows/generate_report.yml/runs?per_page=5&event=workflow_dispatch`, { headers });
        if (!r.ok) return;
        const data = await r.json();
        const run = (data.workflow_runs || []).find(run => {
          return new Date(run.created_at).getTime() >= triggerTime - 10000;
        });
        if (run) {
          runId = run.id;
          setProgressStep('queue', 'done');
          setProgressStep('run', 'active');
          const elapsed = document.getElementById('pstep-run-label');
          if (elapsed) elapsed.textContent = `Running: ${_runNoun(ticker)}…`;
        }
        return;
      }

      // Poll the specific run
      const r = await fetch(`https://api.github.com/repos/${repo}/actions/runs/${runId}`, { headers });
      if (!r.ok) return;
      const run = await r.json();

      // Update elapsed time label
      const elapsed = Math.round((Date.now() - triggerTime) / 1000);
      const runLabel = document.getElementById('pstep-run-label');
      if (runLabel) runLabel.textContent = `Running: ${_runNoun(ticker)}… (${elapsed}s)`;

      if (run.status === 'completed') {
        clearInterval(_pollTimer);
        if (run.conclusion === 'success') {
          setProgressStep('run', 'done');
          setProgressStep('done', 'active');
          const doneLabel = document.getElementById('pstep-done-label');
          if (doneLabel) doneLabel.textContent = `✓ Done! Reloading in 3 seconds…`;
          setTimeout(() => window.location.reload(), 3000);
        } else {
          setProgressStep('run', 'failed');
          showAddStatus('error', `Workflow finished with status: ${run.conclusion}. Check GitHub Actions for details.`);
          const btn = document.getElementById('addStockSubmit');
          if (btn) { btn.disabled = false; btn.textContent = _submitLabel(); }
        }
      }
    } catch (_) {}
  }, 10000);
}
{% endif %}

function showAddStatus(type, msg) {
  const el = document.getElementById('addStockStatus');
  if (!el) return;
  el.className = type ? `modal-status ${type}` : 'modal-status';
  el.textContent = msg;
}

// ── Sticky TOC scroll-spy ───────────────────────────────────────────────────
(function initTOC() {
  if (!('IntersectionObserver' in window)) return;
  const observers = [];

  function setupTOCForTab(sym) {
    const tabEl = document.getElementById('tab-stock-' + sym);
    const tocEl = document.getElementById('toc-' + sym);
    if (!tabEl || !tocEl) return;
    const links = Array.from(tocEl.querySelectorAll('a[href^="#"]'));
    if (!links.length) return;

    const sectionIds = links.map(a => a.getAttribute('href').slice(1));
    const sections = sectionIds.map(id => document.getElementById(id)).filter(Boolean);
    if (!sections.length) return;

    let activeId = null;
    const obs = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          activeId = entry.target.id;
          links.forEach(a => {
            const isActive = a.getAttribute('href') === '#' + activeId;
            a.classList.toggle('toc-active', isActive);
          });
        }
      });
    }, { rootMargin: '-80px 0px -60% 0px', threshold: 0 });

    sections.forEach(s => obs.observe(s));
    observers.push(obs);
  }

  // Set up TOC for each ticker tab
  {% for tr in ctx.ratings %}
  setupTOCForTab({{ tr.symbol | tojson }});
  {% endfor %}
})();

// ── Render markdown in AI text blocks ──────────────────────────────────────
(function renderAIMarkdown() {
  if (typeof marked === 'undefined') return;
  // Disable strikethrough (~~text~~) — Claude uses em-dashes which can trigger it
  const renderer = new marked.Renderer();
  marked.setOptions({ breaks: true, gfm: true });
  // Override del to render as plain text, not <del>
  renderer.del = (token) => token.text;
  document.querySelectorAll('.ai-text').forEach(el => {
    const raw = el.textContent || '';
    if (raw.trim()) {
      el.innerHTML = marked.parse(raw, { renderer });
    }
  });
})();
</script>

