    <!-- ── SECTION: PORTFOLIO THEMES ── -->
    {% if sym_themes %}
    <div class="section" id="sec-themes-{{ tr.symbol }}">
      <div class="section-header">
        <span class="section-title" data-i18n="portfolio_themes">Portfolio Themes</span>
      </div>
      <div class="card" style="padding:14px 16px;">
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
          {% for theme in sym_themes %}
          <span class="theme-chip" title="{{ theme.description }}">{{ theme.name }}</span>
          {% endfor %}
        </div>
