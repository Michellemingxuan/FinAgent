# Copy this file to .env for local development.
# NEVER commit .env to version control.
# In GitHub Actions, set these as repository Secrets (Settings → Secrets → Actions).

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Financial Modeling Prep API key (free tier available) — https://financialmodelingprep.com/
FMP_API_KEY=your_fmp_api_key_here

# WSJ subscription cookie string.
# How to obtain: log into wsj.com → DevTools (F12) → Application → Cookies → wsj.com
# Copy all cookie name=value pairs as a single semicolon-separated string.
# Example format: "wsj_session_id=abc123; djcs_route=xyz; DJSESSION=def456"
# Note: cookies expire ~30 days; update this secret when WSJ article fetches start failing.
WSJ_COOKIE="paste_your_wsj_cookie_string_here"

# Email delivery (Gmail SMTP)
# For Gmail: enable 2FA, then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password_here

# WhatsApp delivery via CallMeBot (free, personal WhatsApp)
# Setup: send "I allow callmebot to send me messages" to +34 644 17 71 40 on WhatsApp
# You'll receive your personal API key back
WHATSAPP_APIKEY=your_callmebot_apikey_here
